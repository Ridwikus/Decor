{
  "name": "decor-dynasty-web",
  "version": "1.0.0",
  "private": true,
  "description": "Décor Dynasty landing page — PHP partials + Tailwind CSS + vanilla JS",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/css/input.css -o ./public/assets/css/app.css --minify",
    "build:js": "node --input-type=commonjs -e \"require('fs').cpSync('src/js','public/assets/js',{recursive:true})\"",
    "build": "npm run build:css && npm run build:js",
    "dev": "tailwindcss -i ./src/css/input.css -o ./public/assets/css/app.css --watch",
    "serve": "php -S localhost:8000 -t public",
    "lint": "eslint src/js tests && prettier --check .",
    "format": "prettier --write .",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.js",
    "test:responsive": "playwright test tests/responsive.spec.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "pa11y": "^8.0.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17"
  }
}
